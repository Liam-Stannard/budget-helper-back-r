# Server
HOST=0.0.0.0
PORT=8080

# Database (MariaDB/MySQL)
DATABASE_URL=mysql://root:root@localhost:3306/budget_helper_back_r

# JWT - raw secret bytes (not base64/hex encoded); use a long random string, 32+ bytes
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-bytes-long
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=86400
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# Logging
RUST_LOG=budget_helper_back_r=debug,tower_http=debug,axum=info

# Dev-only: seeds a demo user (demo / password123) with a few accounts and
# transactions on startup, unless that user already exists. Never enable
# this against a real database.
SEED_DEV_DATA=true

# Bootstraps the first ROLE_ADMIN account on startup — required to ever use /api/v1/users,
# since registration can only create ROLE_USER accounts and those endpoints are admin-only.
# All three must be set together; leave them unset (the default) to skip bootstrapping. Safe
# to leave set permanently: it's a no-op once any admin account exists. Set a real password
# here, not the placeholder below — this is not a dev-only setting.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-real-password
