# Server
HOST=0.0.0.0
PORT=8080

# Database (MariaDB/MySQL)
DATABASE_URL=mysql://root:root@localhost:3306/budget_helper_back_r

# JWT - raw secret bytes (not base64/hex encoded); use a long random string, 32+ bytes
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-bytes-long
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=86400
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# Logging
RUST_LOG=budget_helper_back_r=debug,tower_http=debug,axum=info
